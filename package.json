{
  "name": "private-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-public.mjs && node scripts/bundle-worker.mjs",
    "preview": "node scripts/preview.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"worker/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"shared/**/*.{ts,tsx}\" \"worker/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"shared/**/*.{ts,tsx}\" \"worker/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run tests/unit",
    "test:contracts": "vitest run tests/integration",
    "test:components": "vitest run tests/e2e",
    "test:integration": "npm run test:workers && node scripts/test-runtime.mjs",
    "test:e2e": "playwright test",
    "content:verify": "node scripts/verify-sudoku-catalog.mjs",
    "test:workers": "vitest run --config vitest.workers.config.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
