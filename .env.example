# Environment configuration example
ENVIRONMENT=development
ALLOWED_ORIGIN=http://localhost:5173
CSRF_SECRET=local-development-csrf-secret-minimum-32-chars-hex
SESSION_SECRET=local-development-session-secret-salt

# Provisioning variables (used only by local provisioning script, not committed)
ACCOUNT_A_USERNAME=player_a
ACCOUNT_A_PASSWORD=change_me_local_a
ACCOUNT_B_USERNAME=player_b
ACCOUNT_B_PASSWORD=change_me_local_b
