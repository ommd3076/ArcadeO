# Environment configuration example
ENVIRONMENT=development
ALLOWED_ORIGIN=http://localhost:5173
# Generate a random CSRF_SECRET with npm run setup:local; no fallback is provided.
CSRF_SECRET=

# Provisioning variables (used only by local provisioning script, not committed)
ACCOUNT_A_USERNAME=player_a
ACCOUNT_A_PASSWORD=
ACCOUNT_B_USERNAME=player_b
ACCOUNT_B_PASSWORD=
